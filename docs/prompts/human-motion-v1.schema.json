{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlanWalk additional humans and motion, v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "preset", "models", "actors"],
  "properties": {
    "format": { "const": "planwalk.humans.v1" },
    "preset": { "const": "office" },
    "models": {
      "type": "object", "minProperties": 1, "maxProperties": 2,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/model" }
    },
    "actors": {
      "type": "array", "minItems": 1, "maxItems": 2,
      "items": { "$ref": "#/$defs/actor" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$", "not": { "const": "elena" } },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "angle": { "type": "number", "minimum": -180, "maximum": 180 },
    "speed": { "type": "number", "minimum": 0.2, "maximum": 2 },
    "duration": { "type": "number", "exclusiveMinimum": 0, "maximum": 30 },
    "model": {
      "type": "object", "additionalProperties": false, "required": ["file"],
      "properties": {
        "file": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 _-]{0,63}\\.glb$" },
        "idleClip": { "$ref": "#/$defs/name" },
        "walkClip": { "$ref": "#/$defs/name" },
        "walkRefMps": { "$ref": "#/$defs/speed" }
      },
      "dependentRequired": { "walkClip": ["walkRefMps"], "walkRefMps": ["walkClip"] }
    },
    "spawn": {
      "type": "object", "additionalProperties": false, "required": ["x", "z", "yawDeg"],
      "properties": { "x": { "type": "number" }, "z": { "type": "number" }, "yawDeg": { "$ref": "#/$defs/angle" } }
    },
    "actor": {
      "type": "object", "additionalProperties": false, "required": ["id", "model", "spawn", "steps"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "model": { "$ref": "#/$defs/id" },
        "spawn": { "$ref": "#/$defs/spawn" },
        "steps": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/step" } }
      }
    },
    "step": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["op", "x", "z", "speedMps"],
          "properties": {
            "op": { "const": "walkTo" }, "x": { "type": "number" }, "z": { "type": "number" },
            "speedMps": { "$ref": "#/$defs/speed" }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["op", "yawDeg", "durationSec"],
          "properties": { "op": { "const": "turnTo" }, "yawDeg": { "$ref": "#/$defs/angle" }, "durationSec": { "$ref": "#/$defs/duration" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["op", "durationSec"],
          "properties": { "op": { "const": "wait" }, "durationSec": { "$ref": "#/$defs/duration" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["op", "clip"],
          "properties": { "op": { "const": "play" }, "clip": { "$ref": "#/$defs/name" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["op", "bone", "keys"],
          "properties": {
            "op": { "const": "pose" }, "bone": { "$ref": "#/$defs/name" },
            "keys": { "type": "array", "minItems": 3, "maxItems": 16, "items": { "$ref": "#/$defs/key" } }
          }
        }
      ]
    },
    "key": {
      "type": "object", "additionalProperties": false, "required": ["tSec", "xyzDeg"],
      "properties": {
        "tSec": { "type": "number", "minimum": 0, "maximum": 10 },
        "xyzDeg": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/angle" } }
      }
    }
  }
}
